<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenHdFlightLog.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="OpenHdFlightLog.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="OpenHD FlightLog Studio"
        MinWidth="1120"
        MinHeight="720"
        Width="1440"
        Height="900">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#223040"/>
            <Setter Property="Background" Value="#111A24"/>
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8F0F8"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="#0F1720"/>
            <Setter Property="Foreground" Value="#E8F0F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
        </Style>
    </Window.Styles>

    <DockPanel Background="#0B1118">
        <Border DockPanel.Dock="Top"
                Background="#101923"
                BorderBrush="#223040"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Text="OpenHD FlightLog Studio"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F3F7FB"
                           Margin="0,0,12,0"/>
                <Button Grid.Column="1"
                        Content="Import Log"
                        Command="{Binding ImportLogCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="2"
                        Content="Load OpenHD MAVLink"
                        Command="{Binding LoadOpenHdDefinitionsCommand}"
                        IsEnabled="{Binding !IsBusy}"/>
                <Button Grid.Column="3"
                        Content="Refresh"
                        Command="{Binding RefreshAllCommand}"/>
                <TextBlock Grid.Column="4"
                           Text="{Binding OpenHdRepositoryPath}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#9FB0C2"/>
                <ProgressBar Grid.Column="5"
                             Width="170"
                             Height="6"
                             IsIndeterminate="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"/>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#101923"
                BorderBrush="#223040"
                BorderThickness="0,1,0,0"
                Padding="16,9">
            <TextBlock Text="{Binding Status}" Foreground="#C8D5E2" TextTrimming="CharacterEllipsis"/>
        </Border>

        <TabControl Margin="14">
            <TabItem Header="Flight Logs">
                <Grid RowDefinitions="260,*" ColumnDefinitions="410,*" RowSpacing="12" ColumnSpacing="12">
                    <Border Classes="panel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                                <TextBlock Classes="sectionTitle" Text="Imported Logs"/>
                                <Button Grid.Column="1" Content="Re-decode" Command="{Binding RedecodeSelectedLogCommand}"/>
                                <Button Grid.Column="2" Content="Delete" Command="{Binding DeleteLogCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Logs}"
                                      SelectedItem="{Binding SelectedLog}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="64"/>
                                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="Frames" Binding="{Binding MessageCount}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="panel">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="MAVLink Frames" Margin="12,10"/>
                            <DataGrid ItemsSource="{Binding Messages}"
                                      SelectedItem="{Binding SelectedMessage}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding PacketIndex}" Width="70"/>
                                    <DataGridTextColumn Header="Time ms" Binding="{Binding TimeMs}" Width="90"/>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190"/>
                                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="130"/>
                                    <DataGridTextColumn Header="Dialect" Binding="{Binding Dialect}" Width="110"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="260"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding MessageId}" Width="75"/>
                                    <DataGridTextColumn Header="Sys" Binding="{Binding SystemId}" Width="58"/>
                                    <DataGridTextColumn Header="Comp" Binding="{Binding ComponentId}" Width="65"/>
                                    <DataGridTextColumn Header="Seq" Binding="{Binding Sequence}" Width="58"/>
                                    <DataGridTextColumn Header="Offset" Binding="{Binding ByteOffset}" Width="86"/>
                                    <DataGridTextColumn Header="Len" Binding="{Binding PayloadLength}" Width="60"/>
                                    <DataGridTextColumn Header="CRC" Binding="{Binding Checksum}" Width="86"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="panel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                                <TextBlock Classes="sectionTitle" Text="Decoded / Editable Fields"/>
                                <Button Grid.Column="1" Content="Save Field" Command="{Binding SaveFieldCommand}"/>
                                <Button Grid.Column="2" Content="Delete Field" Command="{Binding DeleteFieldCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Fields}"
                                      SelectedItem="{Binding SelectedField}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="260"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*"/>
                                    <DataGridTextColumn Header="Numeric" Binding="{Binding NumericValue}" Width="140"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Variables">
                <Grid RowDefinitions="2*,*" RowSpacing="12">
                    <Border Classes="panel">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Classes="sectionTitle"
                                       Text="Automatic Log Variables"
                                       Margin="12,10"/>
                            <DataGrid ItemsSource="{Binding LogVariables}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time ms" Binding="{Binding TimeMs}" Width="90"/>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="190"/>
                                    <DataGridTextColumn Header="Packet" Binding="{Binding PacketIndex}" Width="82"/>
                                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="130"/>
                                    <DataGridTextColumn Header="Dialect" Binding="{Binding Dialect}" Width="110"/>
                                    <DataGridTextColumn Header="Msg ID" Binding="{Binding MessageId}" Width="85"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="250"/>
                                    <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="240"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*"/>
                                    <DataGridTextColumn Header="Numeric" Binding="{Binding NumericValue}" Width="120"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90"/>
                                    <DataGridTextColumn Header="Sys" Binding="{Binding SystemId}" Width="58"/>
                                    <DataGridTextColumn Header="Comp" Binding="{Binding ComponentId}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="panel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                                <TextBlock Classes="sectionTitle" Text="Manual Variables / Notes"/>
                                <Button Grid.Column="1" Content="New" Command="{Binding AddVariableCommand}"/>
                                <Button Grid.Column="2" Content="Save" Command="{Binding SaveVariableCommand}"/>
                                <Button Grid.Column="3" Content="Delete" Command="{Binding DeleteVariableCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Variables}"
                                      SelectedItem="{Binding SelectedVariable}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="260"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="140"/>
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="OSD / UDP Replay">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Border Classes="panel">
                        <Grid ColumnDefinitions="Auto,170,Auto,90,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*"
                              ColumnSpacing="10"
                              Margin="12">
                            <TextBlock Text="UDP Target"
                                       VerticalAlignment="Center"
                                       Foreground="#C8D5E2"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding UdpReplayHost}"
                                     PlaceholderText="127.0.0.1"/>
                            <TextBlock Grid.Column="2"
                                       Text="Port"
                                       VerticalAlignment="Center"
                                       Foreground="#C8D5E2"/>
                            <TextBox Grid.Column="3"
                                     Text="{Binding UdpReplayPort}"/>
                            <Button Grid.Column="4"
                                    Content="Play"
                                    Command="{Binding StartUdpReplayCommand}"/>
                            <Button Grid.Column="5"
                                    Content="Pause"
                                    Command="{Binding StopUdpReplayCommand}"/>
                            <TextBlock Grid.Column="6"
                                       Text="{Binding UdpReplaySpeed}"
                                       VerticalAlignment="Center"
                                       Foreground="#C8D5E2"/>
                            <Button Grid.Column="7"
                                    Content="0.5x"
                                    Command="{Binding SetUdpReplaySpeedHalfCommand}"/>
                            <Button Grid.Column="8"
                                    Content="1x"
                                    Command="{Binding SetUdpReplaySpeedNormalCommand}"/>
                            <Button Grid.Column="9"
                                    Content="2x"
                                    Command="{Binding SetUdpReplaySpeedDoubleCommand}"/>
                            <Button Grid.Column="10"
                                    Content="4x"
                                    Command="{Binding SetUdpReplaySpeedQuadCommand}"/>
                            <TextBlock Grid.Column="11"
                                       Text="{Binding UdpReplaySentPackets, StringFormat='Sent packets: {0:N0}'}"
                                       VerticalAlignment="Center"
                                       Foreground="#9FB0C2"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="1.2*,*" ColumnSpacing="12">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,*,Auto" Margin="18">
                                <TextBlock Classes="sectionTitle" Text="Rendered OSD Frame"/>
                                <Border Grid.Row="1"
                                        Margin="0,14"
                                        Background="#05080D"
                                        BorderBrush="#2C4054"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                                <TextBlock Text="OPENHD"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F7FB"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.Timestamp}"
                                                           Foreground="#9FB0C2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding CurrentOsdFrame.LinkQuality, StringFormat='LQ {0}%'}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Foreground="#67E8A5"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.PacketLoss, StringFormat='Loss {0}%'}"
                                                           Foreground="#F9C74F"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="*,*"
                                              RowDefinitions="*,*"
                                              Margin="0,24"
                                              ColumnSpacing="18"
                                              RowSpacing="18">
                                            <StackPanel>
                                                <TextBlock Text="RSSI" Foreground="#9FB0C2"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.Rssi}"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F7FB"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="SNR" Foreground="#9FB0C2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.Snr}"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F7FB"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock Text="Video bitrate" Foreground="#9FB0C2"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.AirVideoBitrate}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8BD3FF"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="Card temp" Foreground="#9FB0C2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding CurrentOsdFrame.CardTemperature}"
                                                           FontSize="24"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFB86B"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                                            <TextBlock Text="{Binding CurrentOsdFrame.TxPps, StringFormat='TX {0} pps'}"
                                                       Foreground="#C8D5E2"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CurrentOsdFrame.InjectedBitrate}"
                                                       Foreground="#C8D5E2"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding CurrentOsdFrame.RxPps, StringFormat='RX {0} pps'}"
                                                       Foreground="#C8D5E2"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                                    <Button Content="-5s" Command="{Binding SeekBackFiveSecondsCommand}"/>
                                    <Button Grid.Column="1" Content="Previous" Command="{Binding PreviousOsdFrameCommand}"/>
                                    <Slider Grid.Column="2"
                                            Minimum="0"
                                            Maximum="{Binding OsdReplayMaxMs}"
                                            Value="{Binding OsdReplayTimeMs}"/>
                                    <Button Grid.Column="3" Content="Next" Command="{Binding NextOsdFrameCommand}"/>
                                    <Button Grid.Column="4" Content="+5s" Command="{Binding SeekForwardFiveSecondsCommand}"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding OsdReplayTimeMs}"
                                               VerticalAlignment="Center"
                                               Foreground="#9FB0C2"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="panel">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Classes="sectionTitle"
                                           Text="OSD Replay Frames"
                                           Margin="12,10"/>
                                <DataGrid ItemsSource="{Binding OsdReplayFrames}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time ms" Binding="{Binding TimeMs}" Width="90"/>
                                        <DataGridTextColumn Header="LQ" Binding="{Binding LinkQuality}" Width="70"/>
                                        <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="70"/>
                                        <DataGridTextColumn Header="SNR" Binding="{Binding Snr}" Width="70"/>
                                        <DataGridTextColumn Header="Video" Binding="{Binding AirVideoBitrate}" Width="120"/>
                                        <DataGridTextColumn Header="Loss" Binding="{Binding PacketLoss}" Width="80"/>
                                        <DataGridTextColumn Header="Temp" Binding="{Binding CardTemperature}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="MAVLink Definitions">
                <Grid RowDefinitions="2*,*" RowSpacing="12">
                    <Border Classes="panel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                                <TextBlock Classes="sectionTitle" Text="Generated Definitions from OpenHD Headers"/>
                                <Button Grid.Column="1" Content="Save Definition" Command="{Binding SaveDefinitionCommand}"/>
                                <Button Grid.Column="2" Content="Delete Definition" Command="{Binding DeleteDefinitionCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Definitions}"
                                      SelectedItem="{Binding SelectedDefinition}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding MessageId}" Width="86"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="320"/>
                                    <DataGridTextColumn Header="Dialect" Binding="{Binding Dialect}" Width="130"/>
                                    <DataGridTextColumn Header="Len" Binding="{Binding PayloadLength}" Width="70"/>
                                    <DataGridTextColumn Header="CRC" Binding="{Binding CrcExtra}" Width="70"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="*"/>
                                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="panel">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                                <TextBlock Classes="sectionTitle" Text="Field Layout"/>
                                <Button Grid.Column="1" Content="Save Field Def" Command="{Binding SaveDefinitionFieldCommand}"/>
                                <Button Grid.Column="2" Content="Delete Field Def" Command="{Binding DeleteDefinitionFieldCommand}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding DefinitionFields}"
                                      SelectedItem="{Binding SelectedDefinitionField}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Offset" Binding="{Binding PayloadOffset}" Width="82"/>
                                    <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="260"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding ValueType}" Width="120"/>
                                    <DataGridTextColumn Header="Array" Binding="{Binding ArrayLength}" Width="80"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="110"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="DB Activity">
                <Border Classes="panel">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="12,10" ColumnSpacing="8">
                            <TextBlock Classes="sectionTitle" Text="Database Activity Log"/>
                            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDatabaseActivityCommand}"/>
                            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearDatabaseActivityCommand}"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding DatabaseActivity}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="Time" Binding="{Binding ChangedAt}" Width="180"/>
                                <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="150"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding ActivityType}" Width="100"/>
                                <DataGridTextColumn Header="Row ID" Binding="{Binding RowId}" Width="90"/>
                                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="Debug">
                <Border Classes="panel">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10">
                            <TextBlock Classes="sectionTitle" Text="Background Activity"/>
                            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearDebugCommand}"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding DebugEvents}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
